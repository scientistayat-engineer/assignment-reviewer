# --- Groq (LLM) ---
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# --- LangSmith (tracing) ---
# Set LANGSMITH_TRACING=true after adding your LangSmith key.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=assignment-review

# --- App ---
# Force demo mode (offline keyword grader, no API calls): true / false
MOCK_LLM=false
# Teacher-review band on the 0-10 scale (teacher's original rule: 4 to 6)
REVIEW_MIN=4
REVIEW_MAX=6

# --- Login ---
# The teacher account is created/updated from these values on every start. CHANGE THE PASSWORD.
TEACHER_USERNAME=teacher
TEACHER_PASSWORD=teacher123
# Long random string used to sign login cookies (set your own)
SECRET_KEY=change-me-to-a-long-random-string
